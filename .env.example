# Copie este arquivo para ".env" e ajuste se necessário.

# --- Banco de dados (usado pelo docker-compose.yml) ---
POSTGRES_DB=locadora
POSTGRES_USER=locadora
POSTGRES_PASSWORD=locadora123
POSTGRES_PORT=5432

# --- API (usada pelo docker-compose.yml e pela aplicação desktop) ---
API_PORT=8000
# Endereço da API que a aplicação desktop vai usar.
# Se a API estiver em outra máquina, troque "localhost" pelo IP dela.
API_URL=http://localhost:8000
